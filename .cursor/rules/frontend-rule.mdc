## TypeScript Standards

### General Rules
- Use **strict mode** (`"strict": true` in tsconfig.json)
- **Never use `any`** - use `unknown` if type is truly unknown
- Use **explicit return types** for functions
- Use **interface** for object types, **type** for unions/intersections
- Enable all strict type-checking options

### Type Definitions
```typescript
// Good: Explicit types
interface User {
  id: string;
  name: string;
  email: string;
  createdAt: Date;
}

type Status = 'pending' | 'running' | 'completed' | 'failed';

function getUser(id: string): Promise<User> {
  // ...
}

// Bad: Implicit any
function getUser(id) {
  // ...
}

// Bad: Using any
function processData(data: any) {
  // ...
}
```

### Props Types
```typescript
// Good: Define props interface
interface ButtonProps {
  label: string;
  onClick: () => void;
  variant?: 'contained' | 'outlined' | 'text';
  disabled?: boolean;
  children?: React.ReactNode;
}

export const Button: React.FC<ButtonProps> = ({ 
  label, 
  onClick, 
  variant = 'contained',
  disabled = false 
}) => {
  // ...
};

// Alternative: Using type
type ButtonProps = {
  label: string;
  onClick: () => void;
  variant?: 'contained' | 'outlined' | 'text';
};
```

## Component Standards

### Functional Components Only
- Use **functional components** with hooks (no class components)
- Use **React.FC** or explicit return type
- Keep components **small and focused** (< 200 lines)
- **One component per file** (except for small helper components)

### Component Structure
```typescript
import React from 'react';
import { Box, Button, Typography } from '@mui/material';
import { useEvaluation } from '@/hooks/useEvaluation';
import type { EvaluationConfig } from '@/types/evaluation.types';

interface EvaluationControlProps {
  config: EvaluationConfig;
  onStart: () => void;
  onCancel: () => void;
}

/**
 * EvaluationControl component handles starting and canceling evaluations
 * @param config - Evaluation configuration
 * @param onStart - Callback when evaluation starts
 * @param onCancel - Callback when evaluation is canceled
 */
export const EvaluationControl: React.FC<EvaluationControlProps> = ({
  config,
  onStart,
  onCancel,
}) => {
  const { isRunning, progress } = useEvaluation(config);

  const handleStart = () => {
    // Validation logic
    onStart();
  };

  return (
    <Box sx={{ p: 2 }}>
      <Typography variant="h6">Evaluation Controls</Typography>
      <Button 
        variant="contained" 
        onClick={handleStart}
        disabled={isRunning}
      >
        Start Evaluation
      </Button>
      {isRunning && (
        <Button 
          variant="outlined" 
          onClick={onCancel}
          color="error"
        >
          Cancel
        </Button>
      )}
    </Box>
  );
};
```

